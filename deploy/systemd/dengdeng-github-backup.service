[Unit]
Description=DengDeng AI encrypted GitHub database backup
After=network-online.target dengdeng.service
Wants=network-online.target
ConditionPathExists=/etc/dengdeng/github-backup.conf
ConditionPathExists=/etc/dengdeng/github-backup.pass

[Service]
Type=oneshot
User=dengdeng
Group=dengdeng
WorkingDirectory=/var/lib/dengdeng/github-backup
Environment=HOME=/var/lib/dengdeng/github-backup
Environment=DENGDENG_FULLSTACK_ENV_FILE=%d/runtime-env
Environment=DENGDENG_FULLSTACK_UPDATE_CONFIG=%d/update-config
LoadCredential=runtime-env:/etc/dengdeng/dengdeng.env
LoadCredential=update-config:/etc/dengdeng/update.conf
ExecStart=/usr/local/sbin/dengdeng-github-backup
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/dengdeng
ReadWritePaths=/var/lib/dengdeng
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
